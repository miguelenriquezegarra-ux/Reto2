{
  "name": "registro-contratos-vigentes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsx scripts/check-types.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo": "tsx demo.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "verify:live": "tsx scripts/verify-live.ts"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "csv-stringify": "6.6.0",
    "express": "5.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.5",
    "@types/node": "24.9.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
